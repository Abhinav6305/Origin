{
  "redirects": [
    {
      "source": "/hack-a-thon2.0",
      "destination": "/hack-a-thon2.0/",
      "permanent": true
    },
    {
      "source": "/hackathon",
      "destination": "/hack-a-thon2.0/",
      "permanent": false
    },
    {
      "source": "/hackathon2.0",
      "destination": "/hack-a-thon2.0/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/hack-a-thon2.0/admindash.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=:path*"
    }
  ]
}